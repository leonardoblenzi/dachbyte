{
  "name": "dachbyte-seller-hub",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "DACH Hub: catálogo mestre, estoque central e operação multicanal (ML, Magalu, Shopee).",
  "main": "index.js",
  "scripts": {
    "start": "node start.js",
    "dev": "node --watch start.js",
    "worker": "node worker.js",
    "migrate": "node db/migrate.js deploy",
    "migrate:status": "node db/migrate.js status",
    "test": "node --test tests/*.test.js",
    "test:db": "node --test --test-concurrency=1 tests/db.integration.test.js tests/db.e3.integration.test.js tests/db.e4.integration.test.js"
  },
  "engines": {
    "node": ">=20"
  }
}
