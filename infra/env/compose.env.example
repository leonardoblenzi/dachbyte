# Initial access via SSH tunnel: ssh -L 8080:127.0.0.1:80 user@vps
DACHBYTE_BIND_IP=127.0.0.1
DACHBYTE_SITE=http://localhost
# For public staging HTTPS, set a real staging hostname and bind 0.0.0.0.

# Checkout da branch aprovada hub-vps-migration/main do DACH Hub no VPS.
HUB_CHECKOUT_DIR=/opt/dachbyte/hub-pagamento

# Rehearsal Hub: loopback-only port for SSH tunnel, never public ingress.
HUB_REHEARSAL_BIND_PORT=18787
