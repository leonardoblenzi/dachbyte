# Copy to hub.env and keep this file out of Git.
# Shared Hub configuration for all Dachbyte application containers.
# Shared target for the current DACH validation: paymentcontrol.
# Staging and production intentionally use the same Hub during this pilot.
HUB_BASE_URL=https://paymentcontrol.davantti-suite.workers.dev
HUB_INTERNAL_TOKEN=
HUB_LOGIN_MODE=strict
HUB_AUTH_MODE=strict
HUB_ENFORCEMENT=strict
HUB_REQUEST_TIMEOUT_MS=8000
HUB_ACCESS_RETRY_ATTEMPTS=3
HUB_ACCESS_RETRY_DELAY_MS=260
HUB_RESOURCE_BILLING_MODE=monitor
HUB_CREDITS_MODE=monitor
HUB_USAGE_REPORTING=true
