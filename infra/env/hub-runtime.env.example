# DACH Hub runtime (hub-web + hub-scheduler).
# Copie para hub-runtime.env no VPS e mantenha segredos fora do Git.

ENVIRONMENT=production
PORT=8787

# Runtime usa somente a role de aplicacao.
HUB_DATABASE_URL=postgresql://dachbyte_hub_app:CHANGE_ME@postgres:5432/dachbyte_hub?sslmode=disable
HUB_PUBLIC_BASE_URL=https://hub.dachbyte.tech
HUB_INTERNAL_TOKEN=
HUB_ACCESS_ENFORCEMENT_MODE=strict
HUB_PLATFORM_SCOPES_ENABLED=true

# Portal administrativo.
ADMIN_BASE_PATH=/ops-portal
ADMIN_USERNAME=
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Checkout / redirecionamento.
PAYMENT_PROVIDER=asaas
PAYMENT_SUCCESS_REDIRECT_URL=https://dachbyte.tech/selecao-plataforma
SUITE_GATEWAY_BASE_URL=https://dachbyte.tech
RENEWAL_INTENT_SECRET=

# Asaas.
ASAAS_API_KEY=
ASAAS_API_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=

# E-mail.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DACH

# Scheduler Node, sempre interpretado em UTC.
HUB_PIX_RENEWAL_CRON=0 * * * *
HUB_MAINTENANCE_CRON=17 9 * * *

# Sincronizacao operacional com produtos DACH (opcional).
# Use somente as URLs realmente necessarias no ambiente.
MODULE_SYNC_ML_DATABASE_URL=
MODULE_SYNC_SHOPEE_DATABASE_URL=
MODULE_SYNC_TRACKING_DATABASE_URL=
MODULE_SYNC_TRACKING_DATABASE_URLS=
MODULE_SYNC_MADEIRA_DATABASE_URL=

# DACH Chat usage sync (opcional).
DACH_CHAT_BASE_URL=
DACH_CHAT_INTERNAL_TOKEN=

# Telemetria de projetos externos Neon (opcional; nao e banco transacional do Hub).
NEON_API_KEY=
NEON_CONSOLE_API_KEY=
NEON_ORG_ID=
NEON_ML_PROJECT_ID=
NEON_SHOPEE_PROJECT_ID=
NEON_TRACKING_PROJECT_ID=
NEON_MADEIRA_PROJECT_ID=
NEON_SKULEADER_PROJECT_ID=
NEON_ML_PROJECT_NAME=
NEON_SHOPEE_PROJECT_NAME=
NEON_TRACKING_PROJECT_NAME=
NEON_MADEIRA_PROJECT_NAME=
NEON_SKULEADER_PROJECT_NAME=
