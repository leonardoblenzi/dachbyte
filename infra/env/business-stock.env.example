# Runtime do Stock na VPS. A role de aplicacao e separada da role de migration para RLS efetivo.
VOLT_STOCK_DATABASE_URL=postgresql://dachbyte_stock_app:CHANGE_ME@postgres:5432/dachbyte_stock?sslmode=disable
VOLT_STOCK_JWT_SECRET=
VOLT_STOCK_JWT_REFRESH_SECRET=
VOLT_STOCK_QR_HMAC_SECRET=
ALLOW_DB_RESET=NO
ALLOW_DEMO_SEED=NO

# Rotas publicas canonicas (devem coincidir com os build args do Compose)
NEXT_PUBLIC_VOLTSTOCK_BASE_PATH=/business/stock
NEXT_PUBLIC_API_URL=/business/stock/api
