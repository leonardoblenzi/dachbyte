# DACH Ads - Google Ads OAuth / token vault. Copy to ads-google.env.
# Keep the real ads-google.env outside Git.

# Generate once with: openssl rand -base64 32
# Do not rotate this key after accounts are connected without a planned token re-encryption.
ADS_TOKEN_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REDIRECT_URI=https://staging.dachbyte.tech/ads/api/google/oauth/callback
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_DEVELOPER_TOKEN=
