# Usado APENAS pelo servico one-shot business-core-migrate.
# O Core precisa de uma role administrativa separada para migrations e para provisionar/hardenizar a app role.
# Na VPS local, use o admin PostgreSQL somente neste arquivo de migration, nunca no container runtime.
VOLT_CORE_DIRECT_DATABASE_URL=postgresql://dachbyte_admin:CHANGE_ME@postgres:5432/dachbyte_core?sslmode=disable
