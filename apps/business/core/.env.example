NODE_ENV=production

# Database local da VPS. Runtime usa role NOBYPASSRLS; migration usa admin/direct separadamente.
VOLT_CORE_APP_DATABASE_URL=postgresql://dachbyte_core_app:password@postgres:5432/dachbyte_core?sslmode=disable
# Nao injete a URL administrativa no container runtime. Use infra/env/business-core-migrate.env no job de migration.
# VOLT_CORE_DIRECT_DATABASE_URL=postgresql://dachbyte_admin:password@postgres:5432/dachbyte_core?sslmode=disable
VOLT_CORE_DB_POOL_MAX=8

# Auth and session
VOLT_CORE_JWT_SECRET=change-me

# Bootstrap master (create-only). Ative apenas no provisionamento inicial e desligue depois.
VOLT_CORE_BOOTSTRAP_MASTER_ENABLED=false
VOLT_CORE_BOOTSTRAP_MASTER_EMAIL=master@voltcore.local
VOLT_CORE_BOOTSTRAP_MASTER_NAME=Admin Master
VOLT_CORE_BOOTSTRAP_MASTER_PASSWORD=change-me

# Optional CORS
VOLT_CORE_ALLOWED_ORIGINS=https://www.voltcorporation.com.br

# Public canonical routes
VOLT_CORE_PUBLIC_BASE_PATH=/business/core
VOLT_CORE_APP_BASE_PATH=/business/core/app
VOLT_CORE_API_BASE_PATH=/business/core/api
VITE_VOLT_CORE_API_BASE=/business/core/api

# Hub integration
# fallback/mirror/strict exigem URL e token reais do Hub para usuarios comuns.
# disabled desliga a autenticacao Hub (util para desenvolvimento/master local).
HUB_BASE_URL=https://hub.example.com
HUB_INTERNAL_TOKEN=change-me
HUB_REQUEST_TIMEOUT_MS=8000
HUB_AUTH_MODE=strict
HUB_LOGIN_MODE=fallback

# Optional demo seed for disposable environments only
VOLT_CORE_DEMO_SEED_ENABLED=false

# Observability / async integration engine
VOLT_CORE_LOG_LEVEL=info
VOLT_CORE_SLOW_REQUEST_MS=1000
VOLT_CORE_SLOW_QUERY_MS=750
VOLT_CORE_JOB_POLL_MS=3000
VOLT_CORE_JOB_BATCH_SIZE=10
VOLT_CORE_OUTBOX_BATCH_SIZE=20
VOLT_CORE_JOB_LEASE_MS=300000
VOLT_CORE_JOB_RECOVERY_MS=60000
VOLT_CORE_INTEGRATION_MAINTENANCE_MS=21600000
VOLT_CORE_INTEGRATION_RETENTION_DAYS=30
VOLT_CORE_WEBHOOK_RETENTION_DAYS=30
VOLT_CORE_JOB_RETRY_BASE_MS=5000
VOLT_CORE_JOB_RETRY_MAX_MS=900000
# Set true only for maintenance/debug; production normally keeps the worker enabled.
VOLT_CORE_WORKER_DISABLED=false
# Optional company used by `npm run validate:phase-d`; otherwise first active company is used.
VOLT_CORE_PHASE_D_COMPANY_ID=
