# DACH Hub (apps/seller-hub). Copie para infra/env/seller-hub.env na VPS. Segredos fora do Git.
# O app também recebe ./env/hub.env (HUB_BASE_URL e HUB_INTERNAL_TOKEN do hub de acessos).

# Banco próprio (não confundir com dachbyte_hub, do hub de acessos).
HUB_DATABASE_URL=postgres://dachbyte_seller_hub:SENHA@postgres:5432/dachbyte_seller_hub
REDIS_URL=redis://redis:6379
# Mesmo segredo do login único (gateway).
SUITE_JWT_SECRET=
# 32 bytes em base64 ou hex: cifra os tokens dos canais.
HUB_TOKEN_ENCRYPTION_KEY=
HUB_PUBLIC_BASE_URL=https://dachbyte.tech/hub

# Quem entra enquanto o produto dach_hub não está no hub de acessos.
HUB_PLATFORM_ADMIN_EMAILS=
HUB_ALLOWED_TENANTS=
# Piloto de escrita de estoque nos canais. Vazio = ninguém escreve.
HUB_WRITE_TENANTS=

# Apps próprios do DACH Hub em cada canal (ver docs/guides/dach-hub-apps-dos-canais.md).
HUB_ML_APP_ID=
HUB_ML_CLIENT_SECRET=
HUB_MAGALU_CLIENT_ID=
HUB_MAGALU_CLIENT_SECRET=
HUB_MAGALU_SCOPES=
HUB_SHOPEE_PARTNER_ID=
HUB_SHOPEE_PARTNER_KEY=
