# API
NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
VOLT_STOCK_DATABASE_URL=postgresql://dachbyte_stock_app:PASSWORD@postgres:5432/dachbyte_stock?sslmode=disable
# Somente para o job explicito de migration, nunca para o runtime:
# VOLT_STOCK_MIGRATION_DATABASE_URL=postgresql://dachbyte_stock_migrator:PASSWORD@postgres:5432/dachbyte_stock?sslmode=disable
JWT_SECRET=change-me-with-32-plus-random-chars
JWT_REFRESH_SECRET=change-me-with-another-32-plus-random-chars
QR_HMAC_SECRET=change-me-before-production
CORS_ORIGINS=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Infra futura
REDIS_URL=redis://localhost:6379
S3_BUCKET=voltstock-dev

# Protecoes de banco. Nunca habilite em producao durante deploy normal.
ALLOW_DB_RESET=NO
ALLOW_DEMO_SEED=NO

# Public base path. The VPS Docker build overrides NEXT_PUBLIC_API_URL to
# /business/stock/api; local standalone development can keep localhost:4000.
NEXT_PUBLIC_VOLTSTOCK_BASE_PATH=/business/stock
