# Gate final de producao. Copie para production-validation.env e nao versione.
VALIDATION_BASE_URL=https://www.voltcorporation.com.br
VALIDATION_VERIFY_TLS=true
VALIDATION_HTTP_TIMEOUT_SECONDS=15

# Deixe false para o primeiro smoke imediatamente apos o cutover.
# Depois configure contas de teste reais e mude para true para o gate completo.
VALIDATION_RUN_AUTH_TESTS=false
VALIDATION_REQUIRE_AUTH_TESTS=false
VALIDATION_REQUIRE_PASSWORD_RESET_CONFIG=false
VALIDATION_REQUIRE_DESKTOP_RELEASE=false
VALIDATION_DESKTOP_MANIFEST_URL=
VALIDATION_EXPECTED_DESKTOP_CHANNEL=production
VALIDATION_REQUIRE_HUB_VERIFY=false
VALIDATION_REQUIRE_ISOLATION_TESTS=false
VALIDATION_TEST_CHAT_LARGE_UPLOAD=false

VALIDATION_CHAT_USER=
VALIDATION_CHAT_PASSWORD=
VALIDATION_CHAT_B_USER=
VALIDATION_CHAT_B_PASSWORD=
VALIDATION_CORE_USER=
VALIDATION_CORE_PASSWORD=
VALIDATION_CORE_B_USER=
VALIDATION_CORE_B_PASSWORD=
VALIDATION_STOCK_USER=
VALIDATION_STOCK_PASSWORD=
VALIDATION_PRICE_USER=
VALIDATION_PRICE_PASSWORD=
