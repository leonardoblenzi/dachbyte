# DACH Hub (apps/seller-hub). Copie para infra/env/seller-hub.env na VPS. Segredos fora do Git.
# O app também recebe ./env/hub.env (HUB_BASE_URL e HUB_INTERNAL_TOKEN do hub de acessos).

# Banco próprio (não confundir com dachbyte_hub, do hub de acessos).
HUB_DATABASE_URL=postgres://dachbyte_seller_hub:SENHA@postgres:5432/dachbyte_seller_hub
REDIS_URL=redis://redis:6379
# Mesmo segredo do login único (gateway).
SUITE_JWT_SECRET=
# 32 bytes em base64 ou hex: cifra os tokens dos canais.
HUB_TOKEN_ENCRYPTION_KEY=
HUB_PUBLIC_BASE_URL=https://dachbyte.tech/hub

# Quem entra enquanto o produto dach_hub não está no hub de acessos.
HUB_PLATFORM_ADMIN_EMAILS=
HUB_ALLOWED_TENANTS=
# Piloto de escrita de estoque nos canais. Vazio = ninguém escreve.
HUB_WRITE_TENANTS=

# Apps próprios do DACH Hub em cada canal (ver docs/guides/dach-hub-apps-dos-canais.md).
HUB_ML_APP_ID=
HUB_ML_CLIENT_SECRET=
HUB_MAGALU_CLIENT_ID=
HUB_MAGALU_CLIENT_SECRET=
HUB_MAGALU_SCOPES=
HUB_SHOPEE_PARTNER_ID=
HUB_SHOPEE_PARTNER_KEY=

# Limite de contas quando o hub de acessos não informa o do plano (limits.channel_accounts). Vazio = sem limite.
HUB_DEFAULT_ACCOUNT_LIMIT=
# Registro das contas como recurso do dach_hub no hub de acessos: off (padrão) ou monitor.
# Só ligar quando a cobrança do DACH Hub estiver definida: recurso de cobrança pode entrar na decisão de acesso.
HUB_RESOURCE_SYNC=off

# Conexão única da DACHBYTE: contas e chaves do Mercado Livre ficam com o módulo ML.
# Com os dois valores, o cartão do Mercado Livre conecta por ali (o app próprio HUB_ML_* fica sem uso).
HUB_ML_CONNECTIONS_URL=http://seller-ml-web:3000/ml/internal/connections
# Mesmo valor do seller-ml.env (também autoriza os avisos repassados em /hub/internal/notifications).
SELLER_CONNECTIONS_TOKEN=
