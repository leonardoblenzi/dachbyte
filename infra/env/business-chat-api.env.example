# Runtime do Chat API na VPS. Copie para business-chat-api.env e mantenha fora do Git.
ENVIRONMENT=production
DATABASE_URL=postgresql://dachbyte_chat_app:CHANGE_ME@postgres:5432/dachbyte_chat?sslmode=disable
SECRET_KEY=
AUTO_MIGRATE_DB=false
AUTO_SEED_USERS=false
UPLOAD_DIR=/data/uploads

# Bootstrap create-only: obrigatoria em producao para criar o admin apenas se ainda nao existir.
# Depois da criacao, o startup nunca redefine a senha/permissoes da conta existente.
VOLT_CHAT_ADMIN_PASSWORD=

# Origem publica do frontend e link de recuperacao.
FRONTEND_ORIGINS=https://staging.dachbyte.tech
VOLT_CHAT_PASSWORD_RESET_URL=https://staging.dachbyte.tech/business/chat/reset-password

# No primeiro corte, manter anexos no banco/volume. R2 privado fica para etapa posterior.
VOLT_CHAT_FILE_STORAGE_MODE=database
VOLT_CHAT_INTERNAL_USAGE_TOKEN=

# Recuperacao de senha por e-mail
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=VoltChat

# Updater desktop/release manifest. Enquanto FILE_STORAGE_MODE=database,
# nao reutilize este bucket publico para anexos privados do Chat.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_RELEASE_PREFIX=desktop/releases
