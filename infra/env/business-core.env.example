# Runtime do Core na VPS. A role de aplicacao NAO pode ser superuser/BYPASSRLS.
VOLT_CORE_APP_DATABASE_URL=postgresql://dachbyte_core_app:CHANGE_ME@postgres:5432/dachbyte_core?sslmode=disable
VOLT_CORE_DB_POOL_MAX=8
VOLT_CORE_JWT_SECRET=
SUITE_JWT_SECRET=

# Bootstrap master deve ficar desligado no runtime normal.
VOLT_CORE_BOOTSTRAP_MASTER_ENABLED=false

# Rotas publicas canonicas
VOLT_CORE_PUBLIC_BASE_PATH=/business/core
VOLT_CORE_APP_BASE_PATH=/business/core/app
VOLT_CORE_API_BASE_PATH=/business/core/api

# Origem publica permitida
VOLT_CORE_ALLOWED_ORIGINS=https://staging.dachbyte.tech
