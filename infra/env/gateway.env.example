# Copy to gateway.env and fill with STAGING-only values.
# Private PostgreSQL URLs use host postgres and sslmode=disable.
# Create separate databases/roles and restore schemas before starting apps.
DATABASE_URL=
ML_DATABASE_URL=
SHOPEE_DATABASE_URL=
SUITE_JWT_SECRET=
ML_JWT_SECRET=
REDIS_URL=redis://redis:6379
MOD_SITUATION=SANDBOX

# Seleção de plataforma: contas do Mercado Livre da conexão única (API interna do módulo ML).
SELLER_ML_CONNECTIONS_URL=http://seller-ml-web:3000/ml/internal/connections
# Mesmo valor do seller-ml.env e do seller-hub.env.
SELLER_CONNECTIONS_TOKEN=
# Domínio público usado no retorno da autorização do Mercado Livre.
DACHBYTE_PUBLIC_ORIGIN=https://dachbyte.tech
