# Copie para seller-shopee-homolog.env. Instancia TEMPORARIA para a revisao
# (Go Live) do app Shopee novo, apontando para o Sandbox da Shopee.
# Passo a passo: docs/operations/shopee-homolog-sandbox.md
#
# Nunca use aqui o banco, as chaves ou o Partner ID de producao.

# Banco proprio da homologacao (mesmo Postgres da VPS, outro database/role).
SHOPEE_DATABASE_URL=postgres://shopee_homolog:TROCAR@postgres:5432/shopee_homolog?sslmode=disable

# Redis compartilhado, mas em outro banco logico (/7) para as filas nao se
# misturarem com producao. Nao ha worker: nada e consumido.
REDIS_URL=redis://redis:6379/7

# Sandbox da Shopee (Test Partner ID / Test Key do app novo, em "Developing").
SHOPEE_API_BASE=https://openplatform.sandbox.test-stable.shopee.sg
SHOPEE_ADS_API_BASE=https://openplatform.sandbox.test-stable.shopee.sg
SHOPEE_DISCOUNT_API_BASE=https://openplatform.sandbox.test-stable.shopee.sg
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URL=https://homolog.dachbyte.tech/shopee/auth/callback

# URL publica desta instancia e segredo proprio de sessao.
API_BASE_URL=https://homolog.dachbyte.tech/shopee
SESSION_SECRET=
SHOPEE_CORS_ORIGINS=https://homolog.dachbyte.tech

# Sem Hub: login local, sem assinatura e sem cobranca de creditos.
HUB_AUTH_MODE=off
HUB_LOGIN_MODE=off
HUB_RESOURCE_BILLING_MODE=off
