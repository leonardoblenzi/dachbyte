# Copie para .env.desktop somente na maquina Windows que gera os instaladores.
# Nao versione secrets reais.

# Staging possui defaults seguros, mas podem ser sobrescritos aqui.
VOLTCHAT_STAGING_WEB_URL=https://staging.dachbyte.tech/business/chat/
VOLTCHAT_STAGING_API_URL=https://staging.dachbyte.tech/business/chat/api

# Producao e obrigatoria/explícita para evitar publicar instalador no dominio errado.
VOLTCHAT_PRODUCTION_WEB_URL=https://www.voltcorporation.com.br/business/chat/
VOLTCHAT_PRODUCTION_API_URL=https://www.voltcorporation.com.br/business/chat/api

# R2 publico usado apenas para releases desktop.
R2_PUBLIC_BASE_URL=
R2_RELEASE_PREFIX=desktop/releases
R2_STAGING_RELEASE_PREFIX=desktop/staging/releases

# Publicacao oficial exige confirmacao explicita.
CONFIRM_DESKTOP_PRODUCTION_PUBLISH=NO
