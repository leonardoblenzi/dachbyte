# PostgreSQL local da VPS. Copie para postgres.env e gere senhas aleatorias fortes.
POSTGRES_USER=dachbyte_admin
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# Bancos Business criados/provisionados pelo script infra/postgres/provision-business.sh.
DACHBYTE_CHAT_DB=dachbyte_chat
DACHBYTE_CORE_DB=dachbyte_core
DACHBYTE_STOCK_DB=dachbyte_stock
DACHBYTE_PRICE_DB=dachbyte_price
DACHBYTE_ADS_DB=dachbyte_ads
DACHBYTE_HUB_DB=dachbyte_hub

# Roles de runtime/migration. Os nomes podem permanecer nestes defaults.
DACHBYTE_CHAT_APP_ROLE=dachbyte_chat_app
DACHBYTE_CORE_APP_ROLE=dachbyte_core_app
DACHBYTE_STOCK_MIGRATION_ROLE=dachbyte_stock_migrator
DACHBYTE_STOCK_APP_ROLE=dachbyte_stock_app
DACHBYTE_PRICE_MIGRATION_ROLE=dachbyte_price_migrator
DACHBYTE_PRICE_APP_ROLE=dachbyte_price_app
DACHBYTE_ADS_MIGRATION_ROLE=dachbyte_ads_migrator
DACHBYTE_ADS_APP_ROLE=dachbyte_ads_app
DACHBYTE_ADS_WORKER_ROLE=dachbyte_ads_worker
DACHBYTE_HUB_MIGRATION_ROLE=dachbyte_hub_migrator
DACHBYTE_HUB_APP_ROLE=dachbyte_hub_app

# Use senhas diferentes entre as roles e diferentes da senha do admin PostgreSQL.
# Para facilitar as connection strings, prefira secrets URL-safe (por exemplo hex/base64url sem @:/?#).
DACHBYTE_CHAT_APP_DB_PASSWORD=
DACHBYTE_CORE_APP_DB_PASSWORD=
DACHBYTE_STOCK_MIGRATION_DB_PASSWORD=
DACHBYTE_STOCK_APP_DB_PASSWORD=
DACHBYTE_PRICE_MIGRATION_DB_PASSWORD=
DACHBYTE_PRICE_APP_DB_PASSWORD=
DACHBYTE_ADS_MIGRATION_DB_PASSWORD=
DACHBYTE_ADS_APP_DB_PASSWORD=
DACHBYTE_ADS_WORKER_DB_PASSWORD=

# DACH Hub: use senhas diferentes para migrator e runtime.
DACHBYTE_HUB_MIGRATION_DB_PASSWORD=
DACHBYTE_HUB_APP_DB_PASSWORD=
