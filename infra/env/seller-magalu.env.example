# DACHBYTE Seller · Magalu
# Copy to infra/env/seller-magalu.env in the VPS. Keep real secrets out of Git.

# PostgreSQL shared server; seller-magalu owns only schema magalu.*
MAGALU_DATABASE_URL=

# Shared suite identity used to verify suite_auth_token issued by Gateway/Hub.
SUITE_JWT_SECRET=

# Shared Redis. Queue names are isolated with magalu:* prefixes.
REDIS_URL=redis://redis:6379

# Dedicated 32-byte key for OAuth tokens + webhook secrets.
# Accepted formats: 32-byte UTF-8, 64-char hex, or base64 decoding to 32 bytes.
MAGALU_ENCRYPTION_KEY=

# OAuth Magalu / ID Magalu.
MAGALU_OAUTH_CLIENT_ID=
MAGALU_OAUTH_CLIENT_SECRET=
MAGALU_OAUTH_REDIRECT_URI=https://dachbyte.tech/magalu/auth/callback
MAGALU_OAUTH_AUTHORIZE_URL=https://id.magalu.com/login
MAGALU_OAUTH_TOKEN_URL=https://id.magalu.com/oauth/token

# Base de leitura. Quando MAGALU_WRITE_ENABLED=true o app acrescenta automaticamente
# os scopes open:portfolio-prices-seller:write e open:portfolio-stocks-seller:write
# ao consentimento. Antes de habilitar, adicione esses scopes ao client via IDM.
MAGALU_OAUTH_SCOPES="open:portfolio-skus-seller:read open:portfolio-prices-seller:read open:portfolio-stocks-seller:read open:portfolio-categories-seller:read"
MAGALU_OAUTH_STATE_TTL_SECONDS=600
MAGALU_TOKEN_REFRESH_SKEW_SECONDS=900

MAGALU_API_BASE_URL=https://api.magalu.com
MAGALU_SERVICES_BASE_URL=https://services.magalu.com
MAGALU_WEBHOOK_MAX_SKEW_SECONDS=300

# Fail closed by default. Shared Hub URL/token live in hub.env.
MAGALU_HUB_GATE_MODE=strict

# Catálogo read-only.
MAGALU_SYNC_PAGE_SIZE=100
MAGALU_SYNC_DETAIL_CONCURRENCY=6
MAGALU_RATE_LIMIT_SKU_READ_PER_MINUTE=500
MAGALU_RATE_LIMIT_PRICE_READ_PER_MINUTE=800
MAGALU_RATE_LIMIT_STOCK_READ_PER_MINUTE=800

# Etapa 4 · Escritas protegidas.
# Comece false. Depois de liberar os dois scopes de escrita no IDM, mude para true
# e reconecte a conta Magalu para obter novo consentimento/token com esses scopes.
MAGALU_WRITE_ENABLED=false
MAGALU_WRITE_MAX_BATCH_SIZE=50
MAGALU_WRITE_PREVIEW_TTL_SECONDS=300
MAGALU_WRITE_VERIFY_ATTEMPTS=6
MAGALU_WRITE_VERIFY_DELAY_MS=1500

# Margem abaixo dos limites atuais do Magalu (preço write 850/min; estoque write 650/min).
MAGALU_RATE_LIMIT_PRICE_WRITE_PER_MINUTE=800
MAGALU_RATE_LIMIT_STOCK_WRITE_PER_MINUTE=600
