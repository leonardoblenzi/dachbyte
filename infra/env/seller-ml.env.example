# Copy to seller-ml.env and fill with STAGING-only values.
# Private PostgreSQL URLs use host postgres and sslmode=disable.
# Create separate databases/roles and restore schemas before starting apps.
ML_DATABASE_URL=
SUITE_JWT_SECRET=
ML_JWT_SECRET=
ML_TOKEN_ENCRYPTION_KEY=
ML_APP_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
REDIS_URL=redis://redis:6379
MOD_SITUATION=SANDBOX

# Security defaults for production. Keep strict unless you are deliberately
# running a monitored migration/recovery window.
HUB_AUTH_MODE=strict
ML_HUB_GATE_MODE=strict

# MASTER bootstrap is OFF by default. Run `npm --prefix apps/seller-ml run master:bootstrap`
# only when you intentionally want to create the master configured below.
ML_BOOTSTRAP_MASTER=false
ML_BOOTSTRAP_MASTER_EMAIL=
ML_BOOTSTRAP_MASTER_PASSWORD=
ML_BOOTSTRAP_MASTER_NAME=
# Existing non-master users are never promoted unless this is explicitly true.
ML_BOOTSTRAP_MASTER_ALLOW_PROMOTE=false

# Webhook hardening. Mercado Livre currently sends application_id on promotion
# notifications; enable this after confirming the real callback payload in staging.
ML_WEBHOOK_REQUIRE_APPLICATION_ID=false
ML_WEBHOOK_RATE_LIMIT_MAX=3000
ML_WEBHOOK_WORKER_CONCURRENCY=2

# Token lifecycle (Etapa 2). The defaults are safe; these are tuning knobs.
# Refresh before the token reaches this remaining lifetime.
ML_TOKEN_REFRESH_SKEW_MS=90000
# Max wait for another web/worker process that is already refreshing the same account.
ML_TOKEN_REFRESH_LOCK_TIMEOUT_MS=8000
ML_TOKEN_REFRESH_LOCK_POLL_MS=100
# Legacy tokens without access_expires_at are checked at most once per this TTL,
# instead of calling /users/me on every request.
ML_TOKEN_UNKNOWN_EXPIRY_VALIDATION_TTL_MS=300000

# Redis/Bull + API governor (Etapa 3).
# Shared per-account/token guard across web and worker. Defaults are intentionally
# conservative enough to prevent multiple queues from stampeding the ML API.
ML_API_LIMITER_ENABLED=true
ML_API_LIMITER_FAIL_CLOSED=false
ML_API_ACCOUNT_MAX_CONCURRENT=8
ML_API_ACCOUNT_REQUESTS_PER_SECOND=20
ML_API_LIMITER_ACQUIRE_TIMEOUT_MS=10000
ML_API_LIMITER_POLL_MS=50
ML_API_LIMITER_LEASE_MS=60000
ML_API_LIMITER_MAX_COOLDOWN_MS=120000
ML_API_TOKEN_ACCOUNT_MAP_TTL_MS=28800000

# Bull retention. Completed jobs older than 24h and failed jobs older than 7d
# are removed periodically. The cleanup only touches terminal jobs.
ML_BULL_RETENTION_ENABLED=true
ML_BULL_COMPLETED_RETENTION_MS=86400000
ML_BULL_FAILED_RETENTION_MS=604800000
ML_BULL_CLEAN_INTERVAL_MS=21600000
ML_BULL_CLEAN_INITIAL_DELAY_MS=60000
ML_BULL_CLEAN_LIMIT=500
ML_BULL_CLEAN_MAX_BATCHES=4
# Optional comma-separated Bull queue names not covered by the built-in list.
ML_BULL_EXTRA_QUEUES=

# Banco/historicos/schedulers (Etapa 4).
# Cache diario impede que reinicios ou replicas repitam os scans pesados do Hub Usage.
HUB_USAGE_TABLE_CACHE_TTL_MS=21600000
HUB_USAGE_REPORT_CACHE_TTL_MS=72000000
HUB_USAGE_HTTP_TIMEOUT_MS=5000
HUB_USAGE_LOOKBACK_DAYS=30

# Retencao conservadora de historicos. Comeca DESLIGADA por seguranca.
# Ative somente depois de validar backup e os periodos abaixo. Use 0 em uma categoria para nao apagar nada dela.
ML_DATA_RETENTION_ENABLED=false
ML_DATA_RETENTION_INTERVAL_MS=86400000
ML_DATA_RETENTION_INITIAL_DELAY_MS=300000
ML_DATA_RETENTION_BATCH_SIZE=2000
ML_DATA_RETENTION_MAX_BATCHES=20
ML_DATA_RETENTION_PRICE_HISTORY_DAYS=730
ML_DATA_RETENTION_REPUTATION_DAYS=730
ML_DATA_RETENTION_RANKING_DAYS=1095
ML_DATA_RETENTION_STOCK_EVENTS_DAYS=365
ML_DATA_RETENTION_SYNC_RUNS_DAYS=365
ML_DATA_RETENTION_HUB_USAGE_CACHE_DAYS=14

# Dependencias/infra HTTP e PostgreSQL (Etapa 5).
# O parser JSON global fica em 1 MB; rotas grandes declaradas no proprio router
# continuam usando os limites especificos de 2/4/8/10/50 MB.
ML_JSON_BODY_LIMIT=1mb
ML_URLENCODED_BODY_LIMIT=128kb

# Pool PostgreSQL do modulo ML. Em VPS local use sslmode=disable na ML_DATABASE_URL.
ML_DB_POOL_MAX=10
ML_DB_IDLE_TIMEOUT_MS=30000
ML_DB_CONNECTION_TIMEOUT_MS=10000
# Para banco externo com sslmode=require/verify-*, a verificacao de certificado fica
# ligada por padrao. So use false se o provedor exigir explicitamente.
ML_DB_SSL_REJECT_UNAUTHORIZED=true
# Limites defensivos da leitura XLSX de Caracteristicas.
ML_XLSX_IMPORT_MAX_ROWS=25000
ML_XLSX_IMPORT_MAX_COLUMNS=512
ML_XLSX_IMPORT_MAX_SHEETS=20
