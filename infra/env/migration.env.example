# Copie para migration.env SOMENTE durante a migracao Neon -> PostgreSQL local.
# Este arquivo contem credenciais sensiveis dos bancos antigo e novo; mantenha fora do Git e remova/arquive com seguranca apos o corte.

# Fontes Neon atuais (preferir endpoints diretos, nao pooler, para pg_dump).
SOURCE_CHAT_DATABASE_URL=
SOURCE_CORE_DATABASE_URL=
SOURCE_STOCK_DATABASE_URL=
SOURCE_PRICE_DATABASE_URL=

# Destinos locais. Devem apontar para o hostname interno "postgres".
# Chat restaura como a propria role runtime/owner.
TARGET_CHAT_DATABASE_URL=postgresql://dachbyte_chat_app:CHANGE_ME@postgres:5432/dachbyte_chat?sslmode=disable
# Core restaura como admin; depois a migration concede privilegios para dachbyte_core_app.
TARGET_CORE_DATABASE_URL=postgresql://dachbyte_admin:CHANGE_ME@postgres:5432/dachbyte_core?sslmode=disable
# Stock/Price restauram como suas roles proprietarias de migration.
TARGET_STOCK_DATABASE_URL=postgresql://dachbyte_stock_migrator:CHANGE_ME@postgres:5432/dachbyte_stock?sslmode=disable
TARGET_PRICE_DATABASE_URL=postgresql://dachbyte_price_migrator:CHANGE_ME@postgres:5432/dachbyte_price?sslmode=disable

# URLs runtime usadas apenas pela verificacao pos-migration.
RUNTIME_CHAT_DATABASE_URL=postgresql://dachbyte_chat_app:CHANGE_ME@postgres:5432/dachbyte_chat?sslmode=disable
RUNTIME_CORE_DATABASE_URL=postgresql://dachbyte_core_app:CHANGE_ME@postgres:5432/dachbyte_core?sslmode=disable
RUNTIME_STOCK_DATABASE_URL=postgresql://dachbyte_stock_app:CHANGE_ME@postgres:5432/dachbyte_stock?sslmode=disable
RUNTIME_PRICE_DATABASE_URL=postgresql://dachbyte_price_app:CHANGE_ME@postgres:5432/dachbyte_price?sslmode=disable

# Travas de seguranca. Troque para YES somente no momento consciente do import.
CONFIRM_BUSINESS_DB_IMPORT=NO
ALLOW_NONEMPTY_TARGET=NO
MIGRATION_BACKUP_DIR=/migration-backups
