# ============================================================
# VoltPrice - exemplo de variaveis de ambiente
# NUNCA versione valores reais de secrets/tokens.
# ============================================================

# Banco Neon dedicado ao VoltPrice.
# Runtime: use a URL pooled do Neon.
DB_VOLTPRICE=postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=verify-full
# Migrations/admin: use a URL direta (nao pooled) do Neon.
DB_VOLTPRICE_DIRECT=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full
# Compatibilidade temporaria com ambientes locais antigos.
# VOLT_PRICE_DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=verify-full
# VOLT_PRICE_DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full

# URL publica do webservice, sem barra final. Importante para OAuth.
# Ex.: https://seu-webservice.onrender.com
VOLT_PRICE_PUBLIC_BASE_URL=

# Chave de 32 bytes em base64 ou 64 hex para AES-256-GCM dos tokens OAuth.
# Exemplo para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VOLT_PRICE_ENCRYPTION_KEY=

VOLT_PRICE_SESSION_COOKIE=volt_price_session
VOLT_PRICE_SESSION_TTL_HOURS=24
VOLT_PRICE_DB_POOL_MAX=10

# Admin Master bootstrap. Ative somente para criacao/recuperacao controlada.
VOLT_PRICE_BOOTSTRAP_MASTER_ENABLED=false
VOLT_PRICE_BOOTSTRAP_MASTER_EMAIL=
VOLT_PRICE_BOOTSTRAP_MASTER_PASSWORD=
# Base32. Em producao, Admin Master exige MFA quando configurado/obrigatorio.
VOLT_PRICE_BOOTSTRAP_MASTER_TOTP_SECRET=

# Manutencao automatica de tokens
VOLT_PRICE_TOKEN_MAINTENANCE=true
VOLT_PRICE_TOKEN_MAINTENANCE_MS=3600000

# Tray. Configure somente no Render; nunca no navegador ou banco de dados.
# O callback cadastrado no app Tray e: ${VOLT_PRICE_PUBLIC_BASE_URL}/volt-price/api/integrations/tray/callback
VOLT_PRICE_TRAY_CONSUMER_KEY=
VOLT_PRICE_TRAY_CONSUMER_SECRET=
# Mercado Livre
# Configure estas credenciais no app Mercado Livre; nao use tokens manuais.
VOLT_PRICE_MELI_CLIENT_ID=
VOLT_PRICE_MELI_CLIENT_SECRET=
VOLT_PRICE_MELI_AUTH_BASE=https://auth.mercadolivre.com.br
VOLT_PRICE_MELI_API_BASE=https://api.mercadolibre.com

# Shopee Open Platform V2. Obrigatorias para conectar ou renovar lojas Shopee.
# Cadastre no app Shopee exatamente o callback:
# ${VOLT_PRICE_PUBLIC_BASE_URL}/volt-price/api/integrations/shopee/callback
# Nunca exponha a Partner Key no navegador, em tickets ou no banco.
VOLT_PRICE_SHOPEE_PARTNER_ID=
VOLT_PRICE_SHOPEE_PARTNER_KEY=
VOLT_PRICE_SHOPEE_API_BASE=https://partner.shopeemobile.com
# Opcionais: mantenha os defaults, salvo orientacao do console/regiao Shopee.
VOLT_PRICE_SHOPEE_AUTH_PARTNER_PATH=/api/v2/shop/auth_partner
VOLT_PRICE_SHOPEE_TOKEN_PATH=/api/v2/auth/token/get
VOLT_PRICE_SHOPEE_REFRESH_PATH=/api/v2/auth/access_token/get
VOLT_PRICE_SHOPEE_ESCROW_PATH=/api/v2/payment/get_escrow_detail
VOLT_PRICE_SHOPEE_ORDER_LIST_PATH=/api/v2/order/get_order_list
VOLT_PRICE_SHOPEE_ORDER_DETAIL_PATH=/api/v2/order/get_order_detail
