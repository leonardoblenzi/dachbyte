# DACH Hub production cutover controls.
# Copy to hub-cutover.env on the VPS. Never commit the real file.

# Direct PostgreSQL URL of the source database used only for final dump/compare.
SOURCE_DATABASE_URL=

# Production target is deliberately fixed to the DACH Hub database.
DACHBYTE_HUB_DB=dachbyte_hub
HUB_CUTOVER_BACKUP_DIR=/backups

# Public destination.
HUB_CUTOVER_PUBLIC_BASE_URL=https://hub.dachbyte.tech
HUB_CUTOVER_WEBHOOK_URL=https://hub.dachbyte.tech/v1/public/webhooks/payment
# Optional strict DNS check. Leave blank when a proxy/CDN intentionally hides the origin IP.
HUB_CUTOVER_EXPECTED_PUBLIC_IP=177.7.52.6

# Existing Asaas webhook identifier. API key remains only in hub-runtime.env.
ASAAS_WEBHOOK_ID=

# Every mutating cutover action is disabled by default.
CONFIRM_HUB_COMMERCIAL_FREEZE=NO
CONFIRM_OLD_HUB_SCHEDULER_DISABLED=NO
CONFIRM_HUB_FINAL_SNAPSHOT=NO
CONFIRM_HUB_PRODUCTION_RESTORE=NO
CONFIRM_ASAAS_WEBHOOK_CHANGE=NO
