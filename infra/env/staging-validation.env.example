# Copie para infra/env/staging-validation.env na VPS. Nao versione credenciais reais.
STAGING_BASE_URL=https://staging.dachbyte.tech
STAGING_VERIFY_TLS=true
STAGING_HTTP_TIMEOUT_SECONDS=15

# O gate completo exige uma conta de teste funcional em cada produto.
# Para rodar apenas o smoke publico, business-staging-ops.sh public-smoke
# sobrescreve esta opcao sem precisar editar o arquivo.
STAGING_RUN_AUTH_TESTS=true
STAGING_REQUIRE_AUTH_TESTS=true

# O probe usa um e-mail inexistente e NAO envia mensagem. Ele apenas confirma
# que Brevo/sender estao configurados no Chat em producao.
STAGING_REQUIRE_PASSWORD_RESET_CONFIG=true

# Ative quando ja houver release interno no R2 que deve ser validado.
STAGING_REQUIRE_DESKTOP_RELEASE=false
STAGING_DESKTOP_MANIFEST_URL=
STAGING_EXPECTED_DESKTOP_CHANNEL=staging

# Valida diretamente o endpoint interno de autenticacao do Hub usando a conta Core.
STAGING_REQUIRE_HUB_VERIFY=true

# Gate de multiempresa. Em staging final, mantenha true e informe as contas B.
STAGING_REQUIRE_ISOLATION_TESTS=true

# Rodar UMA VEZ antes do go-live. O arquivo de 10 MiB aceito fica registrado
# no staging e expira pelo ciclo normal do Chat.
STAGING_TEST_CHAT_LARGE_UPLOAD=false

# Chat (username OU e-mail aceito no campo USER)
STAGING_CHAT_USER=
STAGING_CHAT_PASSWORD=

# Segunda conta Chat de outra empresa. Obrigatoria quando STAGING_REQUIRE_ISOLATION_TESTS=true.
STAGING_CHAT_B_USER=
STAGING_CHAT_B_PASSWORD=

# Core. Use preferencialmente um usuario normal autorizado pelo Hub para que
# o login tambem exercite a integracao Hub -> Core.
STAGING_CORE_USER=
STAGING_CORE_PASSWORD=

# Segunda conta Core de outra empresa. Obrigatoria quando STAGING_REQUIRE_ISOLATION_TESTS=true.
STAGING_CORE_B_USER=
STAGING_CORE_B_PASSWORD=

# Stock
STAGING_STOCK_USER=
STAGING_STOCK_PASSWORD=

# Price
STAGING_PRICE_USER=
STAGING_PRICE_PASSWORD=
