# Copy to business-chat.env and fill with STAGING-only values.
# Private PostgreSQL URLs use host postgres and sslmode=disable.
# Create separate databases/roles and restore schemas before starting apps.
# Canonical web path is compiled into the Chat image by compose.vps.yml.
VOLT_CHAT_PUBLIC_PATH=/business/chat
VOLT_CHAT_PUBLIC_API_URL=/business/chat/api
