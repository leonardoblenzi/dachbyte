# DACH Hub rehearsal snapshot x migrated-target comparison.
# Both databases are restored from the SAME pg_dump, so live source writes after
# the dump cannot create false divergence during comparison.
SOURCE_DATABASE_URL=postgresql://dachbyte_hub_rehearsal_app:CHANGE_ME@postgres:5432/dachbyte_hub_source_rehearsal?sslmode=disable
HUB_DATABASE_URL=postgresql://dachbyte_hub_rehearsal_app:CHANGE_ME@postgres:5432/dachbyte_hub_rehearsal?sslmode=disable

# Deep fingerprints are calculated only for protected tables at or below this row count.
HUB_REHEARSAL_FINGERPRINT_LIMIT=250000
