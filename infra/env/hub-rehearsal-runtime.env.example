# DACH Hub isolated rehearsal runtime.
# Copy to hub-rehearsal-runtime.env. This service is bound only to VPS loopback.

ENVIRONMENT=rehearsal
PORT=8787
HUB_DATABASE_URL=postgresql://dachbyte_hub_rehearsal_app:CHANGE_ME@postgres:5432/dachbyte_hub_rehearsal?sslmode=disable
HUB_PUBLIC_BASE_URL=http://127.0.0.1:18787
HUB_INTERNAL_TOKEN=
HUB_ACCESS_ENFORCEMENT_MODE=strict
HUB_PLATFORM_SCOPES_ENABLED=true

# Portal admin. Use secure rehearsal values; do not commit them.
ADMIN_BASE_PATH=/ops-portal
ADMIN_USERNAME=
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Checkout. Production Asaas must NOT be configured in rehearsal.
PAYMENT_PROVIDER=asaas
PAYMENT_SUCCESS_REDIRECT_URL=http://127.0.0.1:18787/checkout/success
SUITE_GATEWAY_BASE_URL=
RENEWAL_INTENT_SECRET=

# Optional Asaas sandbox only.
ASAAS_API_KEY=
ASAAS_API_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=

# Email is disabled until an explicit rehearsal key is supplied.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DACH

# Scheduler is NOT started automatically in rehearsal.
HUB_PIX_RENEWAL_CRON=0 * * * *
HUB_MAINTENANCE_CRON=17 9 * * *
CONFIRM_HUB_REHEARSAL_SCHEDULER=NO

# Product integrations disabled by default during rehearsal.
MODULE_SYNC_ML_DATABASE_URL=
MODULE_SYNC_SHOPEE_DATABASE_URL=
MODULE_SYNC_TRACKING_DATABASE_URL=
MODULE_SYNC_TRACKING_DATABASE_URLS=
MODULE_SYNC_MADEIRA_DATABASE_URL=
DACH_CHAT_BASE_URL=
DACH_CHAT_INTERNAL_TOKEN=

# Optional external Neon telemetry. Leave blank in first rehearsal.
NEON_API_KEY=
NEON_CONSOLE_API_KEY=
NEON_ORG_ID=
NEON_ML_PROJECT_ID=
NEON_SHOPEE_PROJECT_ID=
NEON_TRACKING_PROJECT_ID=
NEON_MADEIRA_PROJECT_ID=
NEON_SKULEADER_PROJECT_ID=
NEON_ML_PROJECT_NAME=
NEON_SHOPEE_PROJECT_NAME=
NEON_TRACKING_PROJECT_NAME=
NEON_MADEIRA_PROJECT_NAME=
NEON_SKULEADER_PROJECT_NAME=
