# DACH Hub rehearsal database preparation.
# Copy to hub-rehearsal-db.env. Never commit real credentials.

# Source currently used by the Hub. Prefer a direct PostgreSQL endpoint for pg_dump.
SOURCE_DATABASE_URL=

# Temporary database only. Safety code requires the name to end with _rehearsal.
DACHBYTE_HUB_REHEARSAL_DB=dachbyte_hub_rehearsal
DACHBYTE_HUB_REHEARSAL_SNAPSHOT_DB=dachbyte_hub_source_rehearsal
DACHBYTE_HUB_REHEARSAL_MIGRATION_ROLE=dachbyte_hub_rehearsal_migrator
DACHBYTE_HUB_REHEARSAL_APP_ROLE=dachbyte_hub_rehearsal_app
DACHBYTE_HUB_REHEARSAL_MIGRATION_DB_PASSWORD=
DACHBYTE_HUB_REHEARSAL_APP_DB_PASSWORD=

# Must be changed consciously before prepare/destroy.
CONFIRM_HUB_REHEARSAL_RESET=NO
HUB_REHEARSAL_ACTION=prepare
HUB_REHEARSAL_BACKUP_DIR=/backups
