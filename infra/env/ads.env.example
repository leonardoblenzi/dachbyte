# DACH Ads runtime (API + worker). Copy to ads.env.
DATABASE_URL=postgresql://dachbyte_ads_app:CHANGE_ME@postgres:5432/dachbyte_ads
ADS_WORKER_DATABASE_URL=postgresql://dachbyte_ads_worker:CHANGE_ME@postgres:5432/dachbyte_ads
REDIS_URL=redis://redis:6379

# Hub is the only production identity/access source.
ADS_AUTH_MODE=hub
# Must be the same secret used by the suite/gateway to sign suite_auth_token.
SUITE_JWT_SECRET=CHANGE_ME_SHARED_SUITE_SECRET
ADS_HUB_MODULE=dach_ads

# Required before connecting Google/Meta. Generate 32 random bytes, e.g.:
# openssl rand -base64 32
ADS_TOKEN_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

# Google Ads OAuth / API
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REDIRECT_URI=https://SEU_DOMINIO/ads/api/google/oauth/callback
GOOGLE_ADS_API_VERSION=v25
# Optional compatibility only. Google sunset developer tokens on 2026-09-09.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
ADS_GOOGLE_INITIAL_LOOKBACK_DAYS=90
ADS_GOOGLE_RECENT_LOOKBACK_DAYS=14
ADS_GOOGLE_SYNC_INTERVAL_MINUTES=120

# Meta Marketing API / OAuth (read-only in Stage 4)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://SEU_DOMINIO/ads/api/meta/oauth/callback
META_GRAPH_API_VERSION=v26.0
META_OAUTH_SCOPES=ads_read,business_management
META_OAUTH_STATE_TTL_SECONDS=600
ADS_META_INITIAL_LOOKBACK_DAYS=90
ADS_META_RECENT_LOOKBACK_DAYS=14
ADS_META_SYNC_INTERVAL_MINUTES=120

ADS_SYNC_WORKER_POLL_MS=10000
ADS_SYNC_JOB_LOCK_MINUTES=30

# Worker heartbeat used by the Compose healthcheck.
ADS_WORKER_HEARTBEAT_KEY=ads:worker:heartbeat
ADS_WORKER_HEARTBEAT_TTL_SECONDS=60

# Local development only. Never use ADS_AUTH_MODE=development in production.
ADS_DEV_TENANT_ID=tenant-dev
ADS_DEV_USER_ID=user-dev
ADS_DEV_USER_EMAIL=dev@dachbyte.local
ADS_DEV_USER_NAME=DACH Ads Dev
