# Copy to seller-shopee.env and fill with STAGING-only values.
# Private PostgreSQL URLs use host postgres and sslmode=disable.
# Create separate databases/roles and restore schemas before starting apps.
SHOPEE_DATABASE_URL=
SUITE_JWT_SECRET=
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
REDIS_URL=redis://redis:6379
MOD_SITUATION=SANDBOX
