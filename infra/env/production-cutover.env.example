# Controle do corte final. Copie para production-cutover.env e nao versione.
# Antes do corte, infra/env/compose.env deve usar o MESMO DACHBYTE_SITE e um
# DACHBYTE_BIND_IP publico (nao 127.0.0.1).
PRODUCTION_BASE_URL=https://www.voltcorporation.com.br
PRODUCTION_VERIFY_TLS=true
PRODUCTION_WAIT_SECONDS=300

# O cutover so executa quando explicitamente autorizado.
CONFIRM_PRODUCTION_CUTOVER=NO

# Rollback troca somente as imagens Docker. Banco nao e restaurado automaticamente.
CONFIRM_PRODUCTION_ROLLBACK=NO
