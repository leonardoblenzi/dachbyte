# DACH Hub migration environment.
# Copie para hub-migrate.env no VPS. Nao reutilize a role runtime aqui.

HUB_DATABASE_URL=postgresql://dachbyte_hub_migrator:CHANGE_ME@postgres:5432/dachbyte_hub?sslmode=disable

# Preencha somente ao liberar conscientemente uma migration manual/destrutiva.
# Exemplo: MIGRATION_BACKUP_CONFIRMED=047_remove_legacy_billing_finance
MIGRATION_BACKUP_CONFIRMED=
