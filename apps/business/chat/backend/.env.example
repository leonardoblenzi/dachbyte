ENVIRONMENT=development
DATABASE_URL=sqlite:///./sordchat.db
SECRET_KEY=change-me
FRONTEND_ORIGINS=https://www.voltcorporation.com.br,https://voltcorporation.com.br
AUTO_MIGRATE_DB=true
AUTO_SEED_USERS=true
UPLOAD_DIR=uploads

VOLT_CHAT_ADMIN_PASSWORD=VoltAdmin@172839

# Token exclusivo para consultas agregadas do Hub sobre usuarios e armazenamento.
VOLT_CHAT_INTERNAL_USAGE_TOKEN=change-me-shared-with-hub

# Optional private chat attachment storage. Keep database during validation; switch to r2 only after the R2 bucket and credentials are configured.
VOLT_CHAT_FILE_STORAGE_MODE=database
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_CHAT_FILE_PREFIX=chat/files

# Optional in-memory query latency counters. No SQL or message content is stored.
VOLT_CHAT_DB_QUERY_METRICS=false
VOLT_CHAT_DB_QUERY_SLOW_MS=250
